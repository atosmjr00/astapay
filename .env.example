# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
NOMAPAY_PUBLIC_KEY=
NOMAPAY_SECRET_KEY=
# Dedicated whsec_... signing secret created for the webhook in NOMAPAY
NOMAPAY_WEBHOOK_SECRET=
# Public HTTPS origin, e.g. https://your-domain.example
APP_URL=
